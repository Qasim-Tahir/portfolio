# Copy to .env.local. Keep all real credentials out of Git and docs/.
FRONTEND_URL=http://localhost:5173
GROQ_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
# Use a stable alias, not a physical collection name, for safe refreshes.
COLLECTION_NAME=portfolio-live
# Required in Vercel; local development without these uses a process-only guard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Preview and production deployments should use separate namespaces.
CHAT_RATE_NAMESPACE=portfolio-chat
CHAT_GLOBAL_RATE_LIMIT=60
CHAT_MAX_CONCURRENT=8
